# Copy to .env and adjust. NEVER commit .env.
# Backend (IIQ_ prefix — see backend/src/invoiceiq/settings.py)

# Runtime
IIQ_APP_ENV=development
IIQ_SECRET_KEY=replace-with-a-long-random-string
IIQ_ENCRYPTION_KEY=replace-with-a-32-byte-minimum-key

# Database + queue (local compose: postgres on host 5433, redis on 6379)
IIQ_DATABASE_URL=postgresql+psycopg://invoiceiq_app:invoiceiq@localhost:5433/invoiceiq
IIQ_REDIS_URL=redis://localhost:6379/0

# Storage
IIQ_STORAGE_BACKEND=local
IIQ_STORAGE_ROOT=./var/storage

# LLM (EU-first: Mistral)
IIQ_LLM_DEFAULT_PROVIDER=mistral
IIQ_LLM_API_KEY=

# CORS (comma-separated)
IIQ_CORS_ORIGINS=http://localhost:3000
